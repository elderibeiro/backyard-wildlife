# Copy this file to .env and fill in only the provider you use.
# Never commit .env or paste keys into YAML, git, or chat logs.

# Google Gemini (default). Create a key at https://aistudio.google.com/apikey
# Stay on the free tier unless you deliberately enable billing.
GEMINI_API_KEY=

# OpenAI (paid). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI Grok (paid). https://console.x.ai/
# Used through the OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=

# Local Ollama (no key). Default assumes Ollama on the same machine.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional override if you keep the config file elsewhere.
# BACKYARD_WILDLIFE_CONFIG=./config.yaml
